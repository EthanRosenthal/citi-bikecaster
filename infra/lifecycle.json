{
  "Rules": [
    {
      "ID": "expire-v2-raw-snapshots",
      "Filter": {
        "Prefix": "v2/raw/"
      },
      "Status": "Enabled",
      "Expiration": {
        "Days": 14
      }
    },
    {
      "ID": "expire-dev-stage",
      "Filter": {
        "Prefix": "dev/"
      },
      "Status": "Enabled",
      "Expiration": {
        "Days": 14
      }
    },
    {
      "ID": "expire-legacy-trash",
      "Filter": {
        "Prefix": "trash/"
      },
      "Status": "Enabled",
      "Expiration": {
        "Days": 1
      }
    },
    {
      "ID": "archive-legacy-station-status",
      "Filter": {
        "Prefix": "station_status/"
      },
      "Status": "Enabled",
      "Transitions": [
        {
          "Days": 0,
          "StorageClass": "DEEP_ARCHIVE"
        }
      ]
    },
    {
      "ID": "archive-legacy-station-info",
      "Filter": {
        "Prefix": "station_info/"
      },
      "Status": "Enabled",
      "Transitions": [
        {
          "Days": 0,
          "StorageClass": "DEEP_ARCHIVE"
        }
      ]
    },
    {
      "ID": "abort-incomplete-multipart-uploads",
      "Filter": {},
      "Status": "Enabled",
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    }
  ]
}
