{
  "Rules": [
    {
      "ID": "expire-v2-raw-snapshots",
      "Filter": {
        "Prefix": "v2/raw/"
      },
      "Status": "Enabled",
      "Expiration": {
        "Days": 14
      }
    },
    {
      "ID": "expire-dev-stage",
      "Filter": {
        "Prefix": "dev/"
      },
      "Status": "Enabled",
      "Expiration": {
        "Days": 14
      }
    },
    {
      "ID": "expire-legacy-trash",
      "Filter": {
        "Prefix": "trash/"
      },
      "Status": "Enabled",
      "Expiration": {
        "Days": 1
      }
    },
    {
      "ID": "abort-incomplete-multipart-uploads",
      "Filter": {},
      "Status": "Enabled",
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    }
  ]
}
